<Window x:Class="SocialNetworkAnalysis.UI.Views.AddNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Node" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0D0E19" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F90A6"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Create New Node" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name"/>
                <TextBox x:Name="TxtName"/>

                <TextBlock Text="Club"/>
                <TextBox x:Name="TxtClub"/>

                <TextBlock Text="Role"/>
                <TextBox x:Name="TxtRole"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Activity (Double)"/>
                        <TextBox x:Name="TxtActivity" Text="0.0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Interaction (Double)"/>
                        <TextBox x:Name="TxtInteraction" Text="0.0"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LblNeighbors" Text="Neighbors (Comma separated IDs, e.g. 1, 5, 10)"/>
                <TextBox x:Name="TxtNeighbors" Height="60" TextWrapping="Wrap" AcceptsReturn="False"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Width="80" Height="30" Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Save" Click="Save_Click" IsDefault="True" Width="80" Height="30" Background="#00E5FF" Foreground="Black" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
