<UserControl x:Class="SocialNetworkAnalysis.UI.Views.EdgePropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="250">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F90A6"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151624"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B2B3D"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#1F1F2E" BorderBrush="#444466" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="EDGE EDITOR" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1">
                <!-- Source Node -->
                <TextBlock Text="Source Node"/>
                <TextBox Text="{Binding Source.Id, Mode=OneWay}" IsReadOnly="True" Opacity="0.5"/>

                <!-- Target Node -->
                <TextBlock Text="Target Node"/>
                <TextBox Text="{Binding Target.Id, Mode=OneWay}" IsReadOnly="True" Opacity="0.5"/>

                <!-- Weight (Editable) -->
                <TextBlock Text="Weight (Session Only)"/>
                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="* Changes to weight are temporary and apply to algorithms only." 
                           Foreground="#555577" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
            </StackPanel>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Content="💾 Update Weight" Command="{Binding DataContext.UpdateEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                         CommandParameter="{Binding}"
                         Background="#00E5FF" Foreground="Black" FontWeight="Bold" Margin="0,0,0,5" Padding="5,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="🗑 Delete Edge" Command="{Binding DataContext.RemoveEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                        CommandParameter="{Binding}"
                        Background="#FF3333" Foreground="White" Margin="0,0,0,5" Padding="5,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
