<Window x:Class="SocialNetworkAnalysis.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SocialNetworkAnalysis.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocialNetworkAnalysis.UI"
        xmlns:views="clr-namespace:SocialNetworkAnalysis.UI.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0D0E19"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1F1F2E"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#E040FB"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFD740"/>
        <SolidColorBrush x:Key="TextPrimary" Color="White"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8F90A6"/>



        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <Border Grid.Row="0" Margin="10,10,0,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{StaticResource TextSecondary}" TextElement.FontWeight="Bold"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D3D5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4D4D7C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="Black"/>
            <!-- Standard combo box is tricky to style fully without huge template -->
        </Style>






        <!-- Control Styles -->
        <Style x:Key="ControlStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B3B4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#151624"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B2B3D"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="#2B2B3D" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <!-- Logo Area -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <Border Width="32" Height="32" Background="{StaticResource AccentCyan}" CornerRadius="8" Margin="0,0,10,0">
                        <Path Data="M10,10 L22,22 M10,22 L22,10" Stroke="Black" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SNA" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>


                <!-- Control Panel embedded in Sidebar -->
                <TextBlock Text="CONTROLS" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,30,0,10"/>

                <Button Content="📁 Load CSV" Command="{Binding LoadCsvCommand}" Background="#2D2D44" HorizontalAlignment="Stretch" Margin="0,5"/>
                <Button Content="🔄 Reset" Command="{Binding ClearSessionCommand}" Background="#8B8000" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                <StackPanel Margin="0,5">
                    <Button Content="📂 Import JSON" Command="{Binding ImportJsonCommand}" Background="#2D2D44" Margin="0,2"/>
                    <Button Content="➕ Add Node" Command="{Binding AddNodeCommand}" Background="#2D552D" Margin="0,2"/>
                    <Button Content="➕ Add Edge" Command="{Binding AddEdgeCommand}" Background="#2D552D" Margin="0,2"/>
                    <Button Content="🗑 Remove Node (Selected)" Command="{Binding RemoveNodeCommand}" Background="#552222" Margin="0,2"/>
                    <Button Content="💾 Export JSON" Command="{Binding ExportJsonCommand}" Background="#2D2D44" Margin="0,2"/>
                    <Button Content="📊 View Matrix" Command="{Binding ShowMatrixCommand}" Background="#2D2D44" Margin="0,2"/>
                    <Button Content="👥 Topluluk Analizi (Kulüp)" Command="{Binding RunCommunityAnalysisCommand}" Background="#0044CC" Margin="0,2" ToolTip="Kulüp bazlı topluluk analizi"/>
                </StackPanel>

                <TextBlock Text="Algorithm" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,5"/>
                <ComboBox ItemsSource="{Binding AlgorithmTypes}" SelectedItem="{Binding SelectedAlgorithm}" Height="30"/>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start ID" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding StartNodeId, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End ID" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding EndNodeId, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <Button Content="▶ Run Analysis" Command="{Binding RunAlgorithmCommand}" Background="{StaticResource AccentPurple}" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="0,10"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" Margin="0,10" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Main Dashboard Content -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top Bar -->
                <RowDefinition Height="Auto"/>
                <!-- KPI Cards -->
                <RowDefinition Height="2*" MinHeight="300"/>
                <!-- Graph & Tables -->
                <RowDefinition Height="*" MinHeight="200"/>
                <!-- Charts -->
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Project Dashboard" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="2025 • Monthly View" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Border Width="35" Height="35" CornerRadius="17" Background="#3B3B4D">
                        <TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- KPI Cards Row -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Total Nodes" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding Nodes.Count}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <!-- Card 2 -->
                <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Total Edges" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding Edges.Count}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <!-- Card 3 -->
                <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Active Algorithm" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedAlgorithm}" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <!-- Card 4 -->
                <Border Grid.Column="3" Background="{StaticResource BgPanel}" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Execution Time" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding ExecutionText}" Foreground="{StaticResource AccentYellow}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle Row: Graph + Steps Table -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Graph View -->
                <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="15" Margin="0,0,15,0" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="Network Map" Foreground="{StaticResource TextSecondary}" Margin="15" Panel.ZIndex="1" IsHitTestVisible="False"/>

                        <!-- Scalable Content -->
                        <!-- Scalable Content with Zoom/Pan Support -->
                        <!-- Scalable Content with Zoom/Pan Support -->
                        <Border ClipToBounds="True" Background="Transparent"
                                MouseWheel="Graph_MouseWheel"
                                MouseLeftButtonDown="Graph_MouseLeftButtonDown"
                                MouseLeftButtonUp="Graph_MouseLeftButtonUp"
                                MouseMove="Graph_MouseMove">
                            <!-- Container with infinite size concept, relying on Transforms -->
                            <Grid x:Name="GraphContainer" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="GraphScale"/>
                                        <TranslateTransform x:Name="GraphTranslate"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Edges -->
                                <ItemsControl ItemsSource="{Binding Edges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Line X1="{Binding Source.X}" Y1="{Binding Source.Y}" 
                                                      X2="{Binding Target.X}" Y2="{Binding Target.Y}"
                                                      Stroke="Transparent" StrokeThickness="5" Cursor="Hand"/>
                                                <!-- Hit Test Area -->
                                                <Line X1="{Binding Source.X}" Y1="{Binding Source.Y}" 
                                                      X2="{Binding Target.X}" Y2="{Binding Target.Y}" IsHitTestVisible="False">
                                                    <Line.Style>
                                                        <Style TargetType="Line">
                                                            <Setter Property="Stroke" Value="#3B3B4D"/>
                                                            <Setter Property="StrokeThickness" Value="1"/>
                                                            <Setter Property="Opacity" Value="0.5"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                    <Setter Property="Stroke" Value="{StaticResource AccentCyan}"/>
                                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Line.Style>
                                                </Line>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Nodes -->
                                <ItemsControl ItemsSource="{Binding Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="99"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent">
                                                <Grid.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>

                                                <Grid.RenderTransform>
                                                    <TranslateTransform X="-15" Y="-15"/>
                                                    <!-- Smaller nodes for dense graph -->
                                                </Grid.RenderTransform>
                                                <Ellipse Width="30" Height="30" Fill="{Binding Color}" ToolTip="{Binding Model.Name}" Cursor="Hand">
                                                    <Ellipse.Effect>
                                                        <BlurEffect Radius="4"/>
                                                        <!-- Slight glow -->
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <!-- ID Text -->
                                                <TextBlock Text="{Binding Id}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontWeight="Bold" Foreground="White" IsHitTestVisible="False" FontSize="14"/>

                                                <!-- Selection Ring -->
                                                <Ellipse Width="34" Height="34" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <!-- Algorithm Info Text (Distances, etc.) -->
                                                <Border CornerRadius="3" Background="#AA000000" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-25,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>

                                                                <!-- Fallback if converter missing: Just check if InfoText is not empty handling in VM or assume visibility based on content size -->
                                                                <DataTrigger Binding="{Binding InfoText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding InfoText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource AccentYellow}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>


                    </Grid>
                </Border>

                <!-- Node/Edge Editor Panel (Moved from Bottom Right) -->
                <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="15" Padding="0">
                    <Grid>
                        <!-- Node Editor -->
                        <views:NodePropertiesPanel DataContext="{Binding SelectedNode}">
                            <views:NodePropertiesPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:NodePropertiesPanel.Style>
                        </views:NodePropertiesPanel>

                        <!-- Edge Editor -->
                        <views:EdgePropertiesPanel DataContext="{Binding SelectedEdge}">
                            <views:EdgePropertiesPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:EdgePropertiesPanel.Style>
                        </views:EdgePropertiesPanel>
                    </Grid>
                </Border>



            </Grid>

            <!-- Bottom Row: Statistics Charts -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Steps Table (Moved from Top Right) -->
                <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="15" Margin="0,0,15,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Algorithm Steps / path" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding AlgorithmSteps}" AutoGenerateColumns="False" 
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3B3B4D" Foreground="{StaticResource TextSecondary}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding StepNumber}" Width="40"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding NodeId}" Width="40"/>
                                <DataGridTextColumn Header="Node" Binding="{Binding NodeName}" Width="*"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Custom Bar Chart Area (Moved from Bottom Left) -->
                <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="15" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Title -->
                            <RowDefinition Height="*"/>
                            <!-- Chart -->
                            <RowDefinition Height="Auto"/>
                            <!-- Divider/Title -->
                            <RowDefinition Height="Auto"/>
                            <!-- List -->
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ChartTitle}" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <!-- Simple Bar Chart Implementation using ItemsControl -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartData}" VerticalAlignment="Bottom" Height="100" Margin="0,0,0,15">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                    <!-- Distribute bars evenly -->
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Margin="5,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <!-- Bar space -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Label -->
                                        </Grid.RowDefinitions>

                                        <!-- Bar -->
                                        <Border Grid.Row="0" Width="20" Background="{StaticResource AccentPurple}" CornerRadius="4,4,0,0">
                                            <Border.Height>
                                                <Binding Path="Value" />
                                            </Border.Height>
                                        </Border>

                                        <!-- Label removed as per request -->
                                        <!-- <TextBlock Grid.Row="1" Text="{Binding Label}" ... /> -->
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Top 5 List -->
                        <TextBlock Grid.Row="2" Text="Top 5 Influential Nodes" Foreground="#8F90A6" FontWeight="SemiBold" FontSize="14" Margin="0,5"/>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding TopInfluentialNodes}" AutoGenerateColumns="False" 
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3B3B4D" Foreground="{StaticResource TextSecondary}"
                                  Height="150">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding StepNumber}" Width="30"/>
                                <DataGridTextColumn Header="Node" Binding="{Binding NodeName}" Width="*"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Description}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
